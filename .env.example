# Supabase production project for Nadid — Mumbai (ap-south-1)
# Project ref: jcyfhfpulckpsdaiecoe
NEXT_PUBLIC_SUPABASE_URL=https://jcyfhfpulckpsdaiecoe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI AEE service.
AEE_BACKEND_URL=

# Shared server-to-server secret between Next.js and AEE.
# Generate a long random value; never expose it with NEXT_PUBLIC_.
AEE_INTERNAL_TOKEN=

# Worker service. Optional values have safe defaults.
WORKER_ID=
WORKER_POLL_INTERVAL_MS=2000

# Public application URL used when configuring Supabase Auth redirects.
# Example: https://nadid.example.com
NEXT_PUBLIC_APP_URL=

# Launch safety limits. Bucket hard limit remains 100 MB.
NADID_MAX_FILE_MB=100
NADID_MAX_UPLOADS_PER_DAY=20
NADID_MAX_ACTIVE_UPLOADS=3

# Payments are intentionally deferred. Keep unset until launch.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
