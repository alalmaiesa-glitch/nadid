# Supabase project dedicated to Nadid
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional FastAPI AEE service, e.g. https://aee.example.com
AEE_BACKEND_URL=

# Public application URL used when configuring Supabase Auth redirects.
# Example: https://nadid.example.com
NEXT_PUBLIC_APP_URL=
